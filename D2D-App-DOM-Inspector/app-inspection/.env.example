# Base URL of the internal application
BASE_URL="https://portal-int.open-frontends.a1.net/door2door#/objekte/neubau"

# Optional: storage state path override
STORAGE_STATE_PATH=auth/storageState.json

# Optional: output directory override
OUTPUT_DIR=output

# Optional: headless mode (false = headed, true = headless)
HEADLESS=false

# Optional: slow down actions in ms (useful for debugging)
SLOW_MO=0

# Optional: default timeout in ms
DEFAULT_TIMEOUT=30000
