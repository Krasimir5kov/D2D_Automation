{
  "name": "d2d_automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript UI and API automation framework.",
  "main": "index.js",
  "scripts": {
    "test:int": "playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:chrome:int": "playwright test --project=chrome",
    "test:chrome:prod": "cross-env TEST_ENV=prod playwright test --project=chrome",
    "test:ui:int": "playwright test tests/ui --project=chrome",
    "test:ui:prod": "cross-env TEST_ENV=prod playwright test tests/ui --project=chrome",
    "test:api:int": "playwright test tests/api --project=chrome",
    "test:api:prod": "cross-env TEST_ENV=prod playwright test tests/api --project=chrome",
    "test:objekte:int": "playwright test tests/ui/objekte --project=chrome",
    "test:objekte:prod": "cross-env TEST_ENV=prod playwright test tests/ui/objekte --project=chrome",
    "test:baulose:int": "playwright test tests/ui/baulose --project=chrome",
    "test:baulose:prod": "cross-env TEST_ENV=prod playwright test tests/ui/baulose --project=chrome",
    "test:salesActions:int": "playwright test tests/ui/salesActions --project=chrome",
    "test:salesActions:prod": "cross-env TEST_ENV=prod playwright test tests/ui/salesActions --project=chrome",
    "test:smokeTestAllPAges:int": "playwright test tests/ui/smokeTestAllPAges --project=chrome",
    "test:smokeTestAllPAges:prod": "cross-env TEST_ENV=prod playwright test tests/ui/smokeTestAllPAges --project=chrome",
    "auth:setup:int": "playwright test --project=setup",
    "auth:setup:prod": "cross-env TEST_ENV=prod playwright test --project=setup",
    "auth:clear": "node scripts/clear-auth-state.cjs",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "typescript": "^6.0.3"
  }
}
