  "description": "Playwright TypeScript UI and API automation framework.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:ui": "playwright test tests/ui --project=chrome",
