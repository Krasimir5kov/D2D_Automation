{
  "name": "d2d_automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript UI and API automation framework.",
  "main": "index.js",
  "scripts": {
    "test:int": "cross-env TEST_ENV=int playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:chrome:int": "cross-env TEST_ENV=int playwright test --project=chrome",
    "test:chrome:prod": "cross-env TEST_ENV=prod playwright test --project=chrome",
    "test:ui:int": "cross-env TEST_ENV=int playwright test tests/ui --project=chrome",
    "test:ui:prod": "cross-env TEST_ENV=prod playwright test tests/ui --project=chrome",
    "test:api:int": "cross-env TEST_ENV=int playwright test tests/api --project=chrome",
    "test:api:prod": "cross-env TEST_ENV=prod playwright test tests/api --project=chrome",
    "test:objekte:int": "cross-env TEST_ENV=int playwright test tests/ui/objekte --project=chrome",
    "test:objekte:prod": "cross-env TEST_ENV=prod playwright test tests/ui/objekte --project=chrome",
    "test:baulose:int": "cross-env TEST_ENV=int playwright test tests/ui/baulose --project=chrome",
    "test:baulose:prod": "cross-env TEST_ENV=prod playwright test tests/ui/baulose --project=chrome",
    "test:salesActions:int": "cross-env TEST_ENV=int playwright test tests/ui/salesActions --project=chrome",
    "test:salesActions:prod": "cross-env TEST_ENV=prod playwright test tests/ui/salesActions --project=chrome",
    "test:smokeTestAllPAges:int": "cross-env TEST_ENV=int playwright test tests/ui/smokeTestAllPAges --project=chrome",
    "test:smokeTestAllPAges:prod": "cross-env TEST_ENV=prod playwright test tests/ui/smokeTestAllPAges --project=chrome",
    "test:channel:int": "cross-env TEST_ENV=int playwright test tests/ui --project=chrome --grep \"@Channel\"",
    "test:channel:prod": "cross-env TEST_ENV=prod playwright test tests/ui --project=chrome --grep \"@Channel\"",
    "test:agent:int": "cross-env TEST_ENV=int playwright test tests/ui --project=chrome --grep \"@Agent\"",
    "test:agent:prod": "cross-env TEST_ENV=prod playwright test tests/ui --project=chrome --grep \"@Agent\"",
    "test:channel-agent:int": "cross-env TEST_ENV=int playwright test tests/ui --project=chrome --grep \"@Channel|@Agent\"",
    "test:channel-agent:prod": "cross-env TEST_ENV=prod playwright test tests/ui --project=chrome --grep \"@Channel|@Agent\"",
    "test:admin-no-konfig-manager:int": "cross-env TEST_ENV=int playwright test tests/ui --project=chrome --grep \"@Admin\" --grep-invert \"@Konfig-Manager\"",
    "test:admin-no-konfig-manager:prod": "cross-env TEST_ENV=prod playwright test tests/ui --project=chrome --grep \"@Admin\" --grep-invert \"@Konfig-Manager\"",
    "test:admin-konfig-manager:int": "cross-env TEST_ENV=int playwright test tests/ui --project=chrome --grep \"@Konfig-Manager\"",
    "test:admin-konfig-manager:prod": "cross-env TEST_ENV=prod playwright test tests/ui --project=chrome --grep \"@Konfig-Manager\"",
    "test:baulose-channel:int": "cross-env TEST_ENV=int playwright test tests/ui/baulose --project=chrome --grep \"@Channel\"",
    "test:baulose-channel:prod": "cross-env TEST_ENV=prod playwright test tests/ui/baulose --project=chrome --grep \"@Channel\"",
    "test:baulose-agent:int": "cross-env TEST_ENV=int playwright test tests/ui/baulose --project=chrome --grep \"@Agent\"",
    "test:baulose-agent:prod": "cross-env TEST_ENV=prod playwright test tests/ui/baulose --project=chrome --grep \"@Agent\"",
    "test:baulose-channel-agent:int": "cross-env TEST_ENV=int playwright test tests/ui/baulose --project=chrome --grep \"@Channel|@Agent\"",
    "test:baulose-channel-agent:prod": "cross-env TEST_ENV=prod playwright test tests/ui/baulose --project=chrome --grep \"@Channel|@Agent\"",
    "test:objekte-channel:int": "cross-env TEST_ENV=int playwright test tests/ui/objekte --project=chrome --grep \"@Channel\"",
    "test:objekte-channel:prod": "cross-env TEST_ENV=prod playwright test tests/ui/objekte --project=chrome --grep \"@Channel\"",
    "test:objekte-agent:int": "cross-env TEST_ENV=int playwright test tests/ui/objekte --project=chrome --grep \"@Agent\"",
    "test:objekte-agent:prod": "cross-env TEST_ENV=prod playwright test tests/ui/objekte --project=chrome --grep \"@Agent\"",
    "test:objekte-channel-agent:int": "cross-env TEST_ENV=int playwright test tests/ui/objekte --project=chrome --grep \"@Channel|@Agent\"",
    "test:objekte-channel-agent:prod": "cross-env TEST_ENV=prod playwright test tests/ui/objekte --project=chrome --grep \"@Channel|@Agent\"",
    "test:salesActions-channel:int": "cross-env TEST_ENV=int playwright test tests/ui/salesActions --project=chrome --grep \"@Channel\"",
    "test:salesActions-channel:prod": "cross-env TEST_ENV=prod playwright test tests/ui/salesActions --project=chrome --grep \"@Channel\"",
    "test:salesActions-agent:int": "cross-env TEST_ENV=int playwright test tests/ui/salesActions --project=chrome --grep \"@Agent\"",
    "test:salesActions-agent:prod": "cross-env TEST_ENV=prod playwright test tests/ui/salesActions --project=chrome --grep \"@Agent\"",
    "test:salesActions-channel-agent:int": "cross-env TEST_ENV=int playwright test tests/ui/salesActions --project=chrome --grep \"@Channel|@Agent\"",
    "test:salesActions-channel-agent:prod": "cross-env TEST_ENV=prod playwright test tests/ui/salesActions --project=chrome --grep \"@Channel|@Agent\"",
    "test:konfiguration-admin-konfig-manager:int": "cross-env TEST_ENV=int playwright test tests/ui/konfiguration --project=chrome --grep \"@Konfig-Manager\"",
    "test:konfiguration-admin-konfig-manager:prod": "cross-env TEST_ENV=prod playwright test tests/ui/konfiguration --project=chrome --grep \"@Konfig-Manager\"",
    "test:konfiguration-admin-no-konfig-manager:int": "cross-env TEST_ENV=int playwright test tests/ui/konfiguration --project=chrome --grep \"@Admin\" --grep-invert \"@Konfig-Manager\"",
    "test:konfiguration-admin-no-konfig-manager:prod": "cross-env TEST_ENV=prod playwright test tests/ui/konfiguration --project=chrome --grep \"@Admin\" --grep-invert \"@Konfig-Manager\"",
    "auth:setup:int": "cross-env TEST_ENV=int playwright test --project=setup",
    "auth:setup:prod": "cross-env TEST_ENV=prod playwright test --project=setup",
    "auth:clear": "node scripts/clear-auth-state.cjs",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "typescript": "^6.0.3"
  }
}
