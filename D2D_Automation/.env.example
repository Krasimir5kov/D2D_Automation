# Scope: which environment to run tests against: "int" (default) or "prod".
TEST_ENV=int

# Scope: set this to the integration environment login URL or application base URL.
INTEGRATION_URL="https://portal-int.open-frontends.a1.net/door2door#/baulose/ftth"

# Scope: set this to the production application base URL. Only used when TEST_ENV=prod.
PROD_URL="https://portal.open-frontends.a1.net/door2door#/baulose/ftth"

# Scope: increase this when manual username, password, and two 2FA steps need more time.
MANUAL_AUTH_TIMEOUT_MINUTES=15

# Scope: keep true to skip manual setup when playwright/.auth/user.json already exists.
REUSE_AUTH_STATE=true

# Scope: optional selector that appears only after successful login.
# AUTH_SUCCESS_SELECTOR=[data-testid="dashboard"]

# Scope: optional URL glob that matches only after successful login.
AUTH_SUCCESS_URL_PATTERN=**/neubau
